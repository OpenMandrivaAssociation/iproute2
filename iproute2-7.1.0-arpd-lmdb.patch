+static MDB_env *env;
+static MDB_dbi dbi;
+
+#define ARPD_MAPSIZE	(16UL * 1024 * 1024)
+#define ARPD_VAL_MAX	32
+
+static unsigned char last_val[ARPD_VAL_MAX];
+
+static int arpd_db_open(const char *path)
+{
+	int rc;
+	MDB_txn *txn;
+
+	rc = mdb_env_create(&env);
+	if (rc) {
+		fprintf(stderr, "mdb_env_create: %s\n", mdb_strerror(rc));
+		return -1;
+	}
+	mdb_env_set_mapsize(env, ARPD_MAPSIZE);
+	/* Keep -b as a single file, matching the historic arpd.db path. */
+	rc = mdb_env_open(env, path, MDB_NOSUBDIR, 0644);
+	if (rc) {
+		fprintf(stderr, "mdb_env_open: %s\n", mdb_strerror(rc));
+		mdb_env_close(env);
+		env = NULL;
+		return -1;
+	}
+	rc = mdb_txn_begin(env, NULL, 0, &txn);
+	if (rc) {
+		fprintf(stderr, "mdb_txn_begin: %s\n", mdb_strerror(rc));
+		mdb_env_close(env);
+		env = NULL;
+		return -1;
+	}
+	rc = mdb_dbi_open(txn, NULL, MDB_CREATE, &dbi);
+	if (rc) {
+		fprintf(stderr, "mdb_dbi_open: %s\n", mdb_strerror(rc));
+		mdb_txn_abort(txn);
+		mdb_env_close(env);
+		env = NULL;
+		return -1;
+	}
+	rc = mdb_txn_commit(txn);
+	if (rc) {
+		fprintf(stderr, "mdb_txn_commit: %s\n", mdb_strerror(rc));
+		mdb_env_close(env);
+		env = NULL;
+		return -1;
+	}
+	return 0;
+}
+
+static void arpd_db_close(void)
+{
+	if (!env)
+		return;
+	mdb_env_close(env);
+	env = NULL;
+}
+
+static int arpd_db_get(struct dbkey *key, void **data, size_t *size)
+{
+	MDB_txn *txn;
+	MDB_val k = { .mv_size = sizeof(*key), .mv_data = key };
+	MDB_val v;
+	int rc;
+
+	if (mdb_txn_begin(env, NULL, MDB_RDONLY, &txn))
+		return -1;
+	rc = mdb_get(txn, dbi, &k, &v);
+	if (rc == 0) {
+		if (v.mv_size == 0 || v.mv_size > ARPD_VAL_MAX) {
+			mdb_txn_abort(txn);
+			return -1;
+		}
+		memcpy(last_val, v.mv_data, v.mv_size);
+		*data = last_val;
+		*size = v.mv_size;
+	} else {
+		*data = NULL;
+		*size = 0;
+	}
+	mdb_txn_abort(txn);
+	return rc == 0 ? 0 : -1;
+}
+
+static int arpd_db_put(struct dbkey *key, void *data, size_t size)
+{
+	MDB_txn *txn;
+	MDB_val k = { .mv_size = sizeof(*key), .mv_data = key };
+	MDB_val v = { .mv_size = size, .mv_data = data };
+	int rc;
+
+	if (mdb_txn_begin(env, NULL, 0, &txn))
+		return -1;
+	rc = mdb_put(txn, dbi, &k, &v, 0);
+	if (rc) {
+		mdb_txn_abort(txn);
+		return -1;
+	}
+	return mdb_txn_commit(txn) ? -1 : 0;
+}
+
+static int arpd_db_del(struct dbkey *key)
+{
+	MDB_txn *txn;
+	MDB_val k = { .mv_size = sizeof(*key), .mv_data = key };
+	int rc;
+
+	if (mdb_txn_begin(env, NULL, 0, &txn))
+		return -1;
+	rc = mdb_del(txn, dbi, &k, NULL);
+	if (rc && rc != MDB_NOTFOUND) {
+		mdb_txn_abort(txn);
+		return -1;
+	}
+	return mdb_txn_commit(txn) ? -1 : 0;
+}
+
+static void arpd_db_sync(void)
+{
+	if (env)
+		mdb_env_sync(env, 1);
+}
